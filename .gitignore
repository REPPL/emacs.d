# Ignore everything by default
/*

# Allow specific files and directories
!.gitignore
!init.el
!README.md
!LICENSE

# Allow docs directory and its contents
!docs/
!docs/*/

# Allow inits directory but be selective about contents
!inits/
inits/*
!inits/repp.org

# Specifically exclude auto-generated and user-specific files
inits/repp.el
inits/custom.el

# Standard Emacs ignores
*.elc
*~
*.~undo-tree
.DS_Store
